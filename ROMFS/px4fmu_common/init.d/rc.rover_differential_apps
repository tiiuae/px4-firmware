#!/bin/sh
# Standard apps for a differential rover.

# Start rover interface CAN driver for SSRC-supported rover types.
if param compare SYS_AUTOSTART 50005
then
	ifup can0
	rover_interface start
fi

if param compare SYS_AUTOSTART 50006
then
	ifup can0
	rover_interface start
fi

if param compare SYS_AUTOSTART 50007
then
	ifup can0
	rover_interface start
fi

# Start rover differential module.
rover_differential start

# Start Land Detector.
land_detector start rover
