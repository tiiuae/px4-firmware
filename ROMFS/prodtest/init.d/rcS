#!/bin/sh
#
# Minimal production test startup script.
#
# Loads parameters from EEPROM, then starts the board sensor drivers
# (rc.board_sensors). The resulting uORB
# topics can be inspected with the 'listener' command, e.g.:
#   listener sensor_accel
#   listener sensor_gyro
#   listener sensor_mag
#   listener sensor_baro
#
#------------------------------------------------------------------------------

set +e
set R /

# Follow the NXP93 startup path: query the manifest for parameter storage,
# then select it for saves and restore values before starting drivers.
if mft query -q -k MTD -s MTD_PARAMETERS -v /fs/mtd_params
then
	param select /fs/mtd_params
	if ! param import
	then
		echo "ERROR [prodtest] EEPROM parameter import failed"
	fi
else
	echo "ERROR [prodtest] EEPROM parameter storage unavailable"
fi

if [ -f ${R}etc/init.d/rc.board_sensors ]
then
	. ${R}etc/init.d/rc.board_sensors
fi

# MAVLink's mission manager requires dataman even in this minimal image.
# Use RAM storage so USB shell access does not depend on an SD card.
dataman start -r

# Match Salukini's default Ethernet addressing and MAVLink peer/ports.
# Parameters have been imported above, so netconfig uses the stored MAV IDs.
if netconfig init
then
	if ! mavlink start -c 192.168.202.254 -o 14540 -u 14541 -r 1000000 -x
	then
		echo "ERROR [prodtest] Ethernet MAVLink startup failed"
	fi
else
	echo "ERROR [prodtest] Ethernet IP configuration failed"
fi

# The USB monitor waits quietly for CDC-ACM readiness and starts MAVLink.
cdcacm_autostart start

# Allow MAVLink communication once production-test startup is complete.
mavlink boot_complete

unset R
